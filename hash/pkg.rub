use random

fn hash(data: Any) -> str {
    random.seed(data)
    let char_list = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ"
    let data = data.to(str)
    for x in range(0, data.len()) {
        let mut tmp = random(1, 62, i32)
        let mut hash_result = ""
        random.seed(tmp)
        if tmp <= 52 {
            hash_result = hash_result + char_list.char(tmp)
        }
    }
    tmp.drop()
    char_list.drop()
    data.drop()
    return hash_result
}